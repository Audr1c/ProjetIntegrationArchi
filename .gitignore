# ==========================================================
#  Projet CNN CIFAR-10 sur SoC — Python → virgule fixe → HLS → FPGA
# ==========================================================

# ---------- Ressources du cours (volumineuses / non redistribuables) ----------
doc/HLS.zip
doc/hls/
# Décommenter pour ne pas versionner les sujets PDF :
# doc/SEI_CNN.pdf
# doc/BoiteAOutilsHLSImage.pdf
# NB : doc/hls/include/ac_fixed.h et ac_int.h sont ignorés avec doc/hls/.
# Si le code HLS les inclut, les copier dans un include/ versionné
# (ac_types est open source, Apache 2.0) pour qu'un clone neuf compile.

# ---------- Données CIFAR-10 et poids générés ----------
# data/ : tout est ignoré sauf les coefficients du CNN (data/coef/)
data/*
!data/coef/
datasets/
cifar-10-batches-*/
cifar-10-python.tar.gz
*.npy
*.npz
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
# Garder les poids/headers exportés de référence : les ajouter avec git add -f

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---------- C / C++ (modèle virgule fixe, testbench) ----------
*.o
*.o.version
*.a
*.so
*.so.version
*.out
*.exe
build/
bin/
obj/
# Core dumps (sans attraper core.cpp / core.h ni un dossier src/core/)
/core
core.[0-9]*

# ---------- Catapult HLS / SCVerify ----------
# Projet Catapult : Catapult.ccs + dossier Catapult/ contenant
#   <TOP>.v1 … .vN/ (rtl.vhdl, concat_rtl.vhdl, *.rpt, *.psr, *.sdc, schedule.gnt,
#   schematic.nlv, CDesignChecker/, scverify/…) et SIF/ (base interne, partials/, *.sif)
# À VERSIONNER : sources C++, testbench, scripts .tcl (directives*.tcl, demo_*.tcl).
# Pour garder un RTL de référence : le copier hors de Catapult/ (ex. rtl/) puis git add.
Catapult/
Catapult_*/
*.ccs
*.ccs.bak
catapult.log
catapult_*.log
design_checker_*
scverify/
SIF/
*.sif
*.ilt
*.nlv
*.gnt
*.psr
*.psr.sdc
*.ldb
# Fichiers générés par Catapult qui pourraient s'échapper du dossier projet
ccs_env.mk
cycle_set.tcl
reg_sharing.tcl
res_sharing.tcl
adjust_char_library.tcl
rtl.vhdl_order*.txt
# messages.txt de Catapult uniquement (pas un éventuel messages.txt perso)
**/Catapult*/**/messages.txt
# Signaux produits par le testbench (décommenter si regénérés à chaque run)
# output_signal.txt
# *_output*.txt

